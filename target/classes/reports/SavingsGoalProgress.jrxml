<jasperReport name="SavingsGoalProgress" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8c717684-6768-4603-b86d-657bdc7bc7b7">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle_Central"/>
	<query language="SQL"><![CDATA[SELECT
    name                                        AS goalname,
    target_amount                               AS targetamount,
    current_amount                              AS presentamount,
    round(current_amount * 100 / target_amount) AS progresspercent,
    to_char(start_date, 'DD Mon YYYY')          AS startdate,
    to_char(target_date, 'DD Mon YYYY')         AS enddate
FROM
    savings_goal_central
WHERE
    delete_flag = 0
    AND target_date >= TRUNC(SYSDATE)
ORDER BY
    progresspercent DESC
]]></query>
