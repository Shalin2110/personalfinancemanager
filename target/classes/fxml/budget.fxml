<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.BudgetController">

    <top>
        <Label style="-fx-font-size: 22; -fx-padding: 15; -fx-font-weight: bold;" text="💰 Budget Management" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 15;">

            <!-- Input section -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label style="-fx-font-weight: bold;" text="Category:" />
                <ComboBox fx:id="cmbCategory" prefWidth="180" />
                <Label style="-fx-font-weight: bold;" text="Amount:" />
                <TextField fx:id="txtAmount" prefHeight="25.0" prefWidth="180.0" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label style="-fx-font-weight: bold;" text="Start Date:" />
                <DatePicker fx:id="dpStart" />
                <Label style="-fx-font-weight: bold;" text="End Date:" />
                <DatePicker fx:id="dpEnd" />
            </HBox>

            <!-- Action buttons -->
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="btnAdd" onAction="#addOrUpdateBudget" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add" />
                <Button onAction="#clearForm" style="-fx-background-color: #607D8B; -fx-text-fill: white;" text="Clear" />
                <Button onAction="#loadBudgets" style="-fx-background-color: #03A9F4; -fx-text-fill: white;" text="Refresh" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblBudget" prefHeight="350" prefWidth="700" style="-fx-border-color: lightgray;">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colCategory" prefWidth="140" text="Category" />
                    <TableColumn fx:id="colAmount" prefWidth="120" text="Amount" />
                    <TableColumn fx:id="colStart" prefWidth="120" text="Start Date" />
                    <TableColumn fx:id="colEnd" prefWidth="120" text="End Date" />
                    <TableColumn fx:id="colActions" prefWidth="150" text="Actions" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
