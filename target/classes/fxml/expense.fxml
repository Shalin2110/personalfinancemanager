<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.ExpenseController" spacing="20"
      style="-fx-padding: 25; -fx-background-color: #F8F9FA;">

    <!-- Header Section -->
    <VBox spacing="8">
        <Label text="💸 Expense Management" style="-fx-font-size: 28; -fx-text-fill: #2C3E50; -fx-font-weight: bold;"/>
        <Label text="Track and manage your expenses" style="-fx-font-size: 14; -fx-text-fill: #7F8C8D;"/>
    </VBox>

    <!-- Input Card -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 25;">
        <Label text="Expense Details" style="-fx-font-size: 18; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-padding: 0 0 15 0;"/>

        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints prefWidth="100" halignment="RIGHT"/>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="100" halignment="RIGHT"/>
                <ColumnConstraints prefWidth="200"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints prefHeight="35"/>
                <RowConstraints prefHeight="35"/>
                <RowConstraints prefHeight="35"/>
            </rowConstraints>

            <!-- Row 1 -->
            <Label text="Category:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <ComboBox fx:id="cmbCategory" prefWidth="180" GridPane.rowIndex="0" GridPane.columnIndex="1"
                      style="-fx-background-radius: 6;"/>

            <Label text="Account:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                   style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <ComboBox fx:id="cmbAccount" prefWidth="180" GridPane.rowIndex="0" GridPane.columnIndex="3"
                      style="-fx-background-radius: 6;"/>

            <!-- Row 2 -->
            <Label text="Amount:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <TextField fx:id="txtAmount" prefWidth="120" style="-fx-background-radius: 6;" promptText="0.00"/>
                <TextField fx:id="txtCurrency" prefWidth="50" style="-fx-background-radius: 6;" promptText="LKR"/>
            </HBox>

            <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="2"
                   style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <DatePicker fx:id="dpDate" prefWidth="180" GridPane.rowIndex="1" GridPane.columnIndex="3"
                        style="-fx-background-radius: 6;"/>

            <!-- Row 3 -->
            <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <TextField fx:id="txtDescription" prefWidth="180" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-background-radius: 6;" promptText="Expense description"/>

            <Label text="Recurring:" GridPane.rowIndex="2" GridPane.columnIndex="2"
                   style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <CheckBox fx:id="chkRecurring" text="Monthly recurring" GridPane.rowIndex="2" GridPane.columnIndex="3"
                      style="-fx-text-fill: #34495E;"/>
        </GridPane>

        <!-- Action Buttons -->
        <HBox spacing="12" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="btnAdd" onAction="#addOrUpdateExpense" text="➕ Add Expense"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16;"/>
            <Button onAction="#clearForm" text="🔄 Clear"
                    style="-fx-background-color: #78909C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16;"/>
            <Button onAction="#loadExpenses" text="📥 Refresh"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16;"/>
        </HBox>
    </VBox>

    <!-- Expenses Table Card -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 20 15 20; -fx-background-color: #F8F9FA; -fx-background-radius: 12 12 0 0;">
            <Label text="Your Expenses" style="-fx-font-size: 18; -fx-text-fill: #2C3E50; -fx-font-weight: bold;"/>
        </HBox>

        <TableView fx:id="tblExpense" prefHeight="350" style="-fx-background-radius: 0 0 12 12; -fx-border-width: 0;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60" text="ID" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colCategory" prefWidth="120" text="Category" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colAccount" prefWidth="120" text="Account" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colAmount" prefWidth="100" text="Amount" style="-fx-alignment: CENTER_RIGHT;"/>
                <TableColumn fx:id="colCurrency" prefWidth="70" text="Currency" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDate" prefWidth="100" text="Date" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDescription" prefWidth="180" text="Description" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colRecurring" prefWidth="80" text="Recurring" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colActions" prefWidth="150" text="Actions" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>

</VBox>