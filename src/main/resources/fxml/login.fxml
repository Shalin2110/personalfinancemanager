<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.LoginController" spacing="20" alignment="CENTER"
      style="-fx-padding: 40; -fx-background-color: linear-gradient(to right, #667eea, #764ba2);">

   <!-- Login Card -->
   <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-padding: 40; -fx-pref-width: 400;">

      <!-- Header -->
      <VBox spacing="8" alignment="CENTER">
         <Label text="🔐 Personal Finance Manager" style="-fx-font-size: 24; -fx-text-fill: #2C3E50; -fx-font-weight: bold;"/>
         <Label text="Sign in to your account" style="-fx-font-size: 14; -fx-text-fill: #7F8C8D;"/>
      </VBox>

      <!-- Login Form -->
      <VBox spacing="15">
         <VBox spacing="5">
            <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <TextField fx:id="txtUsername" style="-fx-background-radius: 6; -fx-padding: 8;" promptText="Enter your username"/>
         </VBox>

         <VBox spacing="5">
            <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #34495E;"/>
            <PasswordField fx:id="txtPassword" style="-fx-background-radius: 6; -fx-padding: 8;" promptText="Enter your password"/>
         </VBox>

         <!-- Status Message -->
         <Label fx:id="lblStatus" style="-fx-font-size: 13; -fx-padding: 5 0;"/>

         <!-- Login Button -->
         <Button fx:id="btnLogin" text="🔓 Sign In" onAction="#handleLogin"
                 style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 14;"/>

         <!-- Register Link -->
         <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
            <Label text="Don't have an account?" style="-fx-text-fill: #7F8C8D;"/>
            <Button fx:id="btnRegister" text="Create account" onAction="#handleRegister"
                    style="-fx-background-color: transparent; -fx-text-fill: #2196F3; -fx-font-weight: bold; -fx-padding: 0; -fx-cursor: hand;"/>
         </HBox>
      </VBox>
   </VBox>

</VBox>