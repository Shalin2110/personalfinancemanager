<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="MonthlyExpenditureAnalysis" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7a360b62-2156-4bb1-b1a4-964a1e8020db">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle_Central"/>
	<parameter name="USER_ID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    TO_CHAR(month_start, 'Month YYYY') AS month_label,
    total_spent,
    month_start
FROM (
    SELECT 
        TRUNC(e.expense_date, 'MM') AS month_start,
        SUM(e.amount) AS total_spent
    FROM system.expense_central e
    JOIN system.category_central c ON e.category_id = c.category_id
    WHERE e.delete_flag = 0
      AND e.user_id = $P{USER_ID}
      AND c.type = 'EXPENSE'
    GROUP BY TRUNC(e.expense_date, 'MM')
)
ORDER BY month_start]]></query>
	<field name="MONTH_LABEL" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="MONTH_LABEL"/>
		<property name="com.jaspersoft.studio.field.label" value="MONTH_LABEL"/>
	</field>
	<field name="TOTAL_SPENT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="TOTAL_SPENT"/>
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_SPENT"/>
	</field>
	<field name="MONTH_START" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="MONTH_START"/>
		<property name="com.jaspersoft.studio.field.label" value="MONTH_START"/>
	</field>
