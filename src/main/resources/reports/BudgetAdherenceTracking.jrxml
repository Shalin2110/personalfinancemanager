<jasperReport name="BudgetAdherenceTracking" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="58cfdc51-1fda-4ea7-b430-ee73cf3eaacd">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle_Central"/>
	<parameter name="USER_ID" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
    c.name              AS category,
    b.start_date        AS startdate,
    b.end_date          AS enddate,
    b.amount            AS budgetamount,
    COALESCE(es.actualspent, 0) AS actualspent,
    ROUND(
      COALESCE(es.actualspent, 0) * 100.0 / NULLIF(b.amount, 0),
      2
    ) AS adherencepercent
FROM budget_central b
JOIN category_central c
  ON b.category_id = c.category_id
LEFT JOIN (
    SELECT
        b2.budget_id,
        SUM(e.amount) AS actualspent
    FROM budget_central b2
    LEFT JOIN expense_central e
      ON e.category_id = b2.category_id
     AND e.expense_date BETWEEN b2.start_date AND b2.end_date
     AND e.delete_flag = 0
     AND e.user_id = $P{USER_ID}
    WHERE b2.delete_flag = 0
      AND b2.user_id = $P{USER_ID}
    GROUP BY b2.budget_id
) es
  ON es.budget_id = b.budget_id
WHERE b.delete_flag = 0
  AND c.type = 'EXPENSE'
  AND b.user_id = $P{USER_ID}
ORDER BY b.start_date DESC
]]></query>
